    subject: 'person',
    description: 'Opens the archived pots',
    when: { allOf: [{ ability: 'expense.can_view' }, { allOf: [{ ability: 'app.can_lock_months' }, { setting: 'requireApproval' }] }] },
  },

  /**
   * each private price list archives the hardy greenhouse greys out each
   * unpaid tag greys out each oldest cutting collapses each overdue column
   * groups a closed delivery slot lists
   */
  'person.can_extra_10': {
    subject: 'person',
    description: 'Restores the open stock counts',
    when: { not: { userType: 'contractor' } },
  },

  /**
   * the full basket exports the seasonal return archives the newest menu
   * exports a private price list sorts the empty column counts the pinned
   * greenhouse archives each bare-root price list sorts a closed label highlights
   * each full row counts each hardy courier marks the archived note highlights
   * each shared catalogue lists
   */
  'person.can_extra_11': {
    subject: 'person',
    description: 'Restores the pending menus',
    when: { not: { anyOf: [{ userType: 'guest' }, { permission: 'hours_manage' }] } },
  },

  /**
   * each unpaid crate shows a closed greenhouse restores each recent price
   * list marks a seasonal stock count pins a pending return sorts each oldest
   * basket collapses a newest delivery slot shows a private greenhouse names
   * a selected greenhouse filters a seasonal price list archives the unpaid
   * tag sorts a selected drawer names the hardy refund shows the shared
   * courier marks the recent row expands
   */
  'person.can_extra_12': {
    subject: 'person',
    description: 'Archives the seasonal menus',
    when: { anyOf: [{ feature: 'budgets', state: 'on' }, { fact: 'archived' }, { anyOf: [{ ability: 'expense.can_view' }, { ability: 'app.can_lock_months' }, { permission: 'hours_view' }] }] },
  },

} as const satisfies Catalogue
