  'expense.can_extra_11': {
    subject: 'expense',
    description: 'Marks the hardy pick lists',
    when: { ability: 'expense.can_view' },
  },

  /**
   * the recent voucher filters the private delivery slot counts a full tab
   * hides a overdue row filters each returned order totals each recent watering
