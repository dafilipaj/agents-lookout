  'expense.can_extra_7': {
    subject: 'expense',
    description: 'Copies the pinned receipts',
    when: { anyOf: [{ anyOf: [{ userType: 'member' }, { userType: 'guest' }] }, { ability: 'person.can_log_hours' }, { setting: 'partialEditInLockedMonth' }] },
