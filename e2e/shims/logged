#!/bin/bash
# A real tool as the World runs it (TEST-2.4): logs its argv to the World's calls log, then runs
# the pinned binary. `exec -a` names the process after this file, inside the World's directory,
# so a failure report shows which World ran it. Which processes are the World's is decided by the
# LOOKOUT_WORLD_ID they inherit, never by this name (TEST-1.8).
#
# TEST-1.2: whoever calls it, with whatever environment, a Fleet started through here (or by what
# it runs) finds binaries on PATH alone, never in Fleet's fallback directories.
FLEET_PATH_ONLY=1
export FLEET_PATH_ONLY
line="$(/bin/date +%H:%M:%S) @NAME@"
for a in "$@"; do printf -v q '%q' "$a"; line="$line $q"; done
printf '%s\n' "$line" >> '@LOG@'
if [ "@NAME@" = fleet ] && [ "$#" -eq 3 ] && [ "$1" = --local ] && [ "$2" = list ] && [ "$3" = --json ]; then
  raw='@EXTRAS@.raw.'$$
  '@REAL@' "$@" > "$raw"
  code=$?
  if [ "$code" -ne 0 ]; then rm -f "$raw"; exit "$code"; fi
  '@NODE@' '@MERGE_SCRIPT@' fleet "$raw" '@EXTRAS@' "$@"
  code=$?
  rm -f "$raw"
  exit "$code"
fi
if [ "@NAME@" = tb-session ] && [ "$1" = search ]; then
  raw='@EXTRAS@.raw.'$$
  '@REAL@' "$@" > "$raw"
  code=$?
  if [ "$code" -ne 0 ]; then rm -f "$raw"; exit "$code"; fi
  '@NODE@' '@MERGE_SCRIPT@' tb-session "$raw" '@EXTRAS@' "$@"
  code=$?
  printf '%s tb-session-finished %s\n' "$(/bin/date +%H:%M:%S)" "$code" >> '@LOG@'
  rm -f "$raw"
  exit "$code"
fi
if [ "@NAME@" = tb-session ] && [ "$1" = show ]; then
  shown="$('@NODE@' '@MERGE_SCRIPT@' tb-session-show - '@EXTRAS@' "$@")"
  if [ -n "$shown" ]; then printf '%s\n' "$shown"; exit 0; fi
fi
exec -a '@SELF@' '@REAL@' "$@"
