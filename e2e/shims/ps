#!/bin/sh
# Sampling is always declared, including in an empty World. Fleet's discovery keeps its shim.
case "$*" in
  *rss*)
    printf '%s\n' 'ps sampling' >> '@LOG@'
    LOOKOUT_FAKE_STATE='@STATE@'
    LOOKOUT_FAKE_VIOLATIONS='@VIOLATIONS@'
    export LOOKOUT_FAKE_STATE LOOKOUT_FAKE_VIOLATIONS
    exec '@NODE@' '@SCRIPT@' "$@"
    ;;
esac
# TODO(TEST-1.10): filter Fleet's machine-wide discovery to this World's panes before Codex Worlds.
exec /bin/ps "$@"
