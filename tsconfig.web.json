{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./web/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["web/src", "shared"]
}
